---
import { Picture } from 'astro:assets';
import Placeholder from './Placeholder.astro';
import { isTodo } from '../../content/placeholders';
import type { MaybeImg, Ratio } from '../../i18n/types';
interface Props {
  image: MaybeImg;
  alt: string;
  ratio: Ratio;
  pendingText: string;
}
const { image, alt, ratio, pendingText } = Astro.props;
const sizes =
  ratio === '16/10' ? '(min-width: 1024px) 680px, 100vw' : '(min-width: 1024px) 320px, 70vw';
---

<div class:list={['media', { 'media--phone': ratio === '9/19.5' }]} style={`aspect-ratio:${ratio}`}>
  {isTodo(image) ? (
    <Placeholder todo={image.label} text={pendingText} />
  ) : (
    <Picture
      src={image}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[480, 800, 1200]}
      sizes={sizes}
      loading="lazy"
      decoding="async"
    />
  )}
</div>

<style>
  .media {
    width: 100%;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .media--phone {
    max-width: 300px;
    margin-inline: auto;
  }
</style>
