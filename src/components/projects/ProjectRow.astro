---
import ProjectMedia from './ProjectMedia.astro';
import SmartLink from '../SmartLink.astro';
import type { Project, SiteContent } from '../../i18n/types';
interface Props {
  project: Project;
  labels: SiteContent['projects']['labels'];
  index: number;
  variant: 'a' | 'b';
}
const { project, labels, index, variant } = Astro.props;
---

<article
  class:list={['row', 'grid', `row--${variant}`]}
  aria-labelledby={`${project.id}-title`}
  data-project-row
>
  <div class="row__media" data-parallax>
    <ProjectMedia
      image={project.image}
      alt={project.imageAlt}
      ratio={project.imageRatio}
      pendingText={labels.imagePending}
    />
  </div>
  <div class="row__body" data-meta>
    <p class="mono row__index">
      <span aria-hidden="true">0{index} · </span>
      {project.status}
    </p>
    <h3 id={`${project.id}-title`} class="row__title">
      {project.name}
    </h3>
    <p class="row__summary">{project.summary}</p>
    <ul class="row__points">
      {project.points.map((point) => (
        <li>{point}</li>
      ))}
    </ul>
    <ul class="tags mono" aria-label={labels.stack}>
      {project.stack.map((tech) => (
        <li>{tech}</li>
      ))}
    </ul>
    <div class="row__links">
      <SmartLink href={project.repo} pendingText={labels.linkPending}>
        {labels.repo}
      </SmartLink>
      <SmartLink href={project.demo} pendingText={labels.linkPending}>
        {labels.demo}
      </SmartLink>
    </div>
  </div>
</article>

<style>
  .row {
    row-gap: 2rem;
    align-items: center;
    padding-block: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid var(--border);
  }
  /* El espacio inferior de la sección ya lo da .section: no se suma el de la última fila. */
  .row:last-child {
    padding-bottom: 0;
  }
  .row__index {
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  .row__title {
    font-size: var(--fs-h2);
    margin-bottom: 1rem;
    overflow-wrap: break-word;
  }
  .row__summary {
    color: var(--text-2);
    max-width: 52ch;
    margin-bottom: 1.25rem;
  }
  .row__points {
    display: grid;
    gap: 6px;
    margin-bottom: 1.5rem;
  }
  .row__points li::before {
    content: '/ ';
    content: '/ ' / '';
    color: var(--accent);
    font-family: var(--font-mono);
  }
  .row__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 1.5rem;
  }
  /* SmartLink renderiza fuera del scope de esta fila: se estila con :global bajo .row__links. */
  .row__links :global(a),
  .row__links :global(.link--pending) {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
  }
  .row__links :global(a) {
    text-decoration-color: var(--border-ui);
    transition:
      color 0.2s,
      text-decoration-color 0.2s;
  }
  .row__links :global(a:hover) {
    color: var(--accent);
    text-decoration-color: currentColor;
  }
  @media (min-width: 1024px) {
    .row--a .row__media {
      grid-column: 1 / 8;
    }
    .row--a .row__body {
      grid-column: 9 / 13;
    }
    .row--b .row__body {
      grid-column: 1 / 7;
      grid-row: 1;
    }
    .row--b .row__media {
      grid-column: 8 / 12;
      grid-row: 1;
    }
  }
</style>
